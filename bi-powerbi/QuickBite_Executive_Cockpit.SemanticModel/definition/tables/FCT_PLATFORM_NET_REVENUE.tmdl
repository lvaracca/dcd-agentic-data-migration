table FCT_PLATFORM_NET_REVENUE

	measure 'Total GMV ($)' = SUM(FCT_PLATFORM_NET_REVENUE[GROSS_MERCHANDISE_VALUE_USD])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Marketplace KPIs

	/// Core profitability metric: Merchant SCD2 Commission + Delivery/Service Fees - Courier Pay - Promo Subsidies - Approved Refunds (Excludes Courier Tips!)
	measure 'Platform Net Revenue ($)' = SUM(FCT_PLATFORM_NET_REVENUE[PLATFORM_NET_REVENUE_USD])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Marketplace KPIs

	measure 'Effective Take-Rate %' =
			DIVIDE(
				[Platform Net Revenue ($)],
				[Total GMV ($)],
				0
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Marketplace KPIs

	measure 'Restaurant Net Revenue ($)' =
			CALCULATE(
				[Platform Net Revenue ($)],
				FCT_PLATFORM_NET_REVENUE[VERT_CD] = 1
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Vertical Breakdown

	measure 'Approved Refund Ratio %' =
			DIVIDE(
				SUM(FCT_PLATFORM_NET_REVENUE[APPROVED_REFUNDS_USD]),
				[Total GMV ($)],
				0
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Risk & Quality

	column CAL_DT
		dataType: dateTime
		formatString: yyyy-mm-dd
		sourceColumn: CAL_DT

	column FISC_YR_N
		dataType: int64
		sourceColumn: FISC_YR_N

	column FISC_QTR_N
		dataType: int64
		sourceColumn: FISC_QTR_N

	column REG_CD
		dataType: string
		sourceColumn: REG_CD

	column CITY_NM
		dataType: string
		sourceColumn: CITY_NM

	column ZONE_ID
		dataType: string
		sourceColumn: ZONE_ID

	column VERT_CD
		dataType: int64
		sourceColumn: VERT_CD

	column VERTICAL_NM
		dataType: string
		sourceColumn: VERTICAL_NM

	column COMPLETED_ORDERS_CNT
		dataType: int64
		sourceColumn: COMPLETED_ORDERS_CNT

	column GROSS_MERCHANDISE_VALUE_USD
		dataType: decimal
		sourceColumn: GROSS_MERCHANDISE_VALUE_USD

	column MERCHANT_COMMISSION_REV_USD
		dataType: decimal
		sourceColumn: MERCHANT_COMMISSION_REV_USD

	column CUSTOMER_FEES_REV_USD
		dataType: decimal
		sourceColumn: CUSTOMER_FEES_REV_USD

	column COURIER_COST_USD
		dataType: decimal
		sourceColumn: COURIER_COST_USD

	column PROMO_SUBSIDY_USD
		dataType: decimal
		sourceColumn: PROMO_SUBSIDY_USD

	column APPROVED_REFUNDS_USD
		dataType: decimal
		sourceColumn: APPROVED_REFUNDS_USD

	column PLATFORM_NET_REVENUE_USD
		dataType: decimal
		sourceColumn: PLATFORM_NET_REVENUE_USD

	column EFFECTIVE_TAKE_RATE_PCT
		dataType: double
		sourceColumn: EFFECTIVE_TAKE_RATE_PCT

	partition FCT_PLATFORM_NET_REVENUE-Partition = m
		mode: directQuery
		source =
				let
				    Source = GoogleBigQuery.Database([BillingProject=GcpProjectId, UseStorageApi=true]),
				    Project = Source{[Name=GcpProjectId]}[Data],
				    MartDataset = Project{[Name=BigQueryDataset,Kind="Schema"]}[Data],
				    Tbl = MartDataset{[Name="FCT_PLATFORM_NET_REVENUE",Kind="Table"]}[Data]
				in
				    Tbl
