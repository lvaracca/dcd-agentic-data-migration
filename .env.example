# ==============================================================================
# Snowflake 30-Day Enterprise Trial Connection (Hosted on GCP us-central1)
# Sign up at: https://signup.snowflake.com
#   - Edition: Enterprise (required for Masking & Row Access Policies)
#   - Cloud Provider: Google Cloud Platform (GCP)
#   - Region: US Central1 (Iowa) [us-central1]
# ==============================================================================
SNOWFLAKE_ACCOUNT=xy12345.us-central1.gcp
SNOWFLAKE_USER=YOUR_SNOWFLAKE_USERNAME
# Supports password OR Programmatic Access Token (PAT)
SNOWFLAKE_PASSWORD=YOUR_PASSWORD_OR_PAT
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=QB_LOAD_WH
SNOWFLAKE_DATABASE=QUICKBITE_PROD

# ==============================================================================
# Google Cloud Target Environment (Co-located in us-central1 for BigLake Iceberg)
# ==============================================================================
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCS_LAKEHOUSE_BUCKET=your-gcp-project-id-quickbite-lakehouse
BQ_BIGLAKE_CONNECTION=biglake-iceberg-conn
BQ_RAW_DATASET=quickbite_raw_ops
BQ_IOT_DATASET=quickbite_raw_iot
BQ_MART_DATASET=quickbite_gold_mart
