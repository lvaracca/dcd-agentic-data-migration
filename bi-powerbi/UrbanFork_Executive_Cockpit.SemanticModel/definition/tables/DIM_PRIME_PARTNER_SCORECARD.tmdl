table DIM_PRIME_PARTNER_SCORECARD

	/// Count of merchants meeting all 4 Prime Partner thresholds (GMV > $25k, Prep < 14m, Quality Dispute < 2%, Rejection < 1%)
	measure 'Active Prime Partners' =
			CALCULATE(
				COUNTROWS(DIM_PRIME_PARTNER_SCORECARD),
				DIM_PRIME_PARTNER_SCORECARD[IS_PRIME_PARTNER] = TRUE()
			)
		formatString: #,0
		displayFolder: Partner Operations

	measure 'Prime GMV Share %' =
			DIVIDE(
				CALCULATE(
					SUM(DIM_PRIME_PARTNER_SCORECARD[TRAILING_90D_GMV_USD]),
					DIM_PRIME_PARTNER_SCORECARD[IS_PRIME_PARTNER] = TRUE()
				),
				SUM(DIM_PRIME_PARTNER_SCORECARD[TRAILING_90D_GMV_USD]),
				0
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Partner Operations

	measure 'Order-Weighted Kitchen Prep (Min)' =
			DIVIDE(
				SUMX(
					DIM_PRIME_PARTNER_SCORECARD,
					DIM_PRIME_PARTNER_SCORECARD[AVG_PREP_MIN_90D] * DIM_PRIME_PARTNER_SCORECARD[DELIVERED_ORDERS_90D]
				),
				SUM(DIM_PRIME_PARTNER_SCORECARD[DELIVERED_ORDERS_90D]),
				0
			)
		formatString: 0.00
		displayFolder: Partner Operations

	column MRC_ID
		dataType: string
		sourceColumn: MRC_ID

	column MRC_NM
		dataType: string
		sourceColumn: MRC_NM

	column VERTICAL_NM
		dataType: string
		sourceColumn: VERTICAL_NM

	column CUISINE_CAT
		dataType: string
		sourceColumn: CUISINE_CAT

	column ZONE_ID
		dataType: string
		sourceColumn: ZONE_ID

	column CITY_NM
		dataType: string
		sourceColumn: CITY_NM

	column REG_CD
		dataType: string
		sourceColumn: REG_CD

	column TRAILING_90D_GMV_USD
		dataType: decimal
		sourceColumn: TRAILING_90D_GMV_USD

	column DELIVERED_ORDERS_90D
		dataType: int64
		sourceColumn: DELIVERED_ORDERS_90D

	column AVG_PREP_MIN_90D
		dataType: double
		sourceColumn: AVG_PREP_MIN_90D

	column QUALITY_DISPUTE_RATE
		dataType: double
		sourceColumn: QUALITY_DISPUTE_RATE

	column MERCHANT_REJECTION_RATE
		dataType: double
		sourceColumn: MERCHANT_REJECTION_RATE

	column CHARGEBACK_DEDUCTIONS_USD
		dataType: decimal
		sourceColumn: CHARGEBACK_DEDUCTIONS_USD

	column IS_PRIME_PARTNER
		dataType: boolean
		sourceColumn: IS_PRIME_PARTNER

	partition DIM_PRIME_PARTNER_SCORECARD-Partition = m
		mode: directQuery
		source =
				let
				    Source = GoogleBigQuery.Database([BillingProject=GcpProjectId, UseStorageApi=true]),
				    Project = Source{[Name=GcpProjectId]}[Data],
				    MartDataset = Project{[Name=BigQueryDataset,Kind="Schema"]}[Data],
				    Tbl = MartDataset{[Name="DIM_PRIME_PARTNER_SCORECARD",Kind="Table"]}[Data]
				in
				    Tbl
