config {
  type: "table",
  name: "RPT_PBI_EXECUTIVE_SUMMARY",
  description: "Migrated from Snowflake TSK_03_REFRESH_PBI_AND_AUDIT. Monthly executive summary across regions and verticals combining Net Revenue and Prime Partner counts.",
  tags: ["tier3_reporting", "migrated_from_snowflake_tasks"]
}

WITH prime_by_reg AS (
  SELECT
    REG_CD,
    VERTICAL_NM,
    COUNTIF(IS_PRIME_PARTNER) AS PRIME_CNT
  FROM ${ref("DIM_PRIME_PARTNER_SCORECARD")}
  GROUP BY 1, 2
)
SELECT
  DATE_TRUNC(f.CAL_DT, MONTH) AS REPORT_MONTH,
  f.REG_CD,
  f.VERTICAL_NM,
  SUM(f.COMPLETED_ORDERS_CNT) AS COMPLETED_ORDERS_CNT,
  SUM(f.GROSS_MERCHANDISE_VALUE_USD) AS GMV_USD,
  SUM(f.PLATFORM_NET_REVENUE_USD) AS PLATFORM_NET_REVENUE_USD,
  SUM(f.APPROVED_REFUNDS_USD) AS APPROVED_REFUNDS_USD,
  ROUND(
    SAFE_DIVIDE(
      CAST(SUM(f.PLATFORM_NET_REVENUE_USD) AS FLOAT64),
      CAST(SUM(f.GROSS_MERCHANDISE_VALUE_USD) AS FLOAT64)
    ),
    4
  ) AS EFFECTIVE_TAKE_RATE_PCT,
  COALESCE(MAX(p.PRIME_CNT), 0) AS ACTIVE_PRIME_PARTNERS_CNT,
  CURRENT_TIMESTAMP() AS LAST_REFRESHED_UTC
FROM ${ref("FCT_PLATFORM_NET_REVENUE")} f
LEFT JOIN prime_by_reg p
  ON f.REG_CD = p.REG_CD
 AND f.VERTICAL_NM = p.VERTICAL_NM
GROUP BY 1, 2, 3
