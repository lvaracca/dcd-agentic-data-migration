      </connection>
      <aliases enabled='yes' />
      <column caption='Approved Refunds ($)' datatype='real' default-format='c&quot;$&quot;#,##0.00;(&quot;$&quot;#,##0.00)' name='[APPROVED_REFUNDS_USD]' role='measure' type='quantitative' />
      <column caption='Order Date' datatype='date' name='[CAL_DT]' role='dimension' type='ordinal' />
      <column caption='City' datatype='string' name='[CITY_NM]' role='dimension' type='nominal' />
      <column caption='Q3 2025 Restaurant Net Revenue ($)' datatype='real' default-format='c&quot;$&quot;#,##0.00;(&quot;$&quot;#,##0.00)' name='[Calculation_q3_rev]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [CAL_DT] &gt;= #2025-07-01# AND [CAL_DT] &lt;= #2025-09-30# AND [VERT_CD] = 1 THEN [PLATFORM_NET_REVENUE_USD] ELSE 0 END)' />
      </column>
      <column caption='FY25 Restaurant Net Revenue ($)' datatype='real' default-format='c&quot;$&quot;#,##0.00;(&quot;$&quot;#,##0.00)' name='[Calculation_fy25_rev]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [FISC_YR_N] = 2025 AND [VERT_CD] = 1 THEN [PLATFORM_NET_REVENUE_USD] ELSE 0 END)' />
      </column>
      <column caption='Effective Take-Rate %' datatype='real' default-format='p0.00%' name='[Calculation_take_rate]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([PLATFORM_NET_REVENUE_USD]) / SUM([GROSS_MERCHANDISE_VALUE_USD])' />
      </column>
      <column caption='Approved Refund Ratio %' datatype='real' default-format='p0.00%' name='[Calculation_refund_ratio]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([APPROVED_REFUNDS_USD]) / SUM([GROSS_MERCHANDISE_VALUE_USD])' />
      </column>
      <column datatype='integer' name='[FISC_YR_N]' role='dimension' type='quantitative' />
      <column caption='GMV ($)' datatype='real' default-format='c&quot;$&quot;#,##0.00;(&quot;$&quot;#,##0.00)' name='[GROSS_MERCHANDISE_VALUE_USD]' role='measure' type='quantitative' />
      <column caption='Platform Net Revenue ($)' datatype='real' default-format='c&quot;$&quot;#,##0.00;(&quot;$&quot;#,##0.00)' name='[PLATFORM_NET_REVENUE_USD]' role='measure' type='quantitative' />
      <column caption='Region' datatype='string' name='[REG_CD]' role='dimension' type='nominal' />
      <column datatype='integer' name='[VERT_CD]' role='dimension' type='quantitative' />
      <column caption='Vertical' datatype='string' name='[VERTICAL_NM]' role='dimension' type='nominal' />
      <column-instance column='[VERTICAL_NM]' derivation='None' name='[none:VERTICAL_NM:nk]' pivot='key' type='nominal' />
      <layout dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <style>
        <style-rule element='mark'>
          <encoding attr='color' field='[none:VERTICAL_NM:nk]' type='palette'>
            <map to='#34a853'>
              <bucket>&quot;Grocery&quot;</bucket>
            </map>
            <map to='#4285f4'>
              <bucket>&quot;Restaurant&quot;</bucket>
            </map>
          </encoding>
        </style-rule>
      </style>
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name='KPI Banner'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#202124' fontname='Tableau Bold' fontsize='12'>Executive KPI Benchmarks (Cent-Level Parity)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table name='KPI Banner'>
        <view>
          <datasources>
            <datasource caption='UrbanFork_Net_Revenue_Snowflake' name='federated.urbanfork01' />
          </datasources>
          <datasource-dependencies datasource='federated.urbanfork01'>
            <column caption='Approved Refunds ($)' datatype='real' default-format='c&quot;$&quot;#,##0.00;(&quot;$&quot;#,##0.00)' name='[APPROVED_REFUNDS_USD]' role='measure' type='quantitative' />
            <column caption='Order Date' datatype='date' name='[CAL_DT]' role='dimension' type='ordinal' />
            <column caption='FY25 Restaurant Net Revenue ($)' datatype='real' default-format='c&quot;$&quot;#,##0.00;(&quot;$&quot;#,##0.00)' name='[Calculation_fy25_rev]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [FISC_YR_N] = 2025 AND [VERT_CD] = 1 THEN [PLATFORM_NET_REVENUE_USD] ELSE 0 END)' />
            </column>
            <column caption='Q3 2025 Restaurant Net Revenue ($)' datatype='real' default-format='c&quot;$&quot;#,##0.00;(&quot;$&quot;#,##0.00)' name='[Calculation_q3_rev]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [CAL_DT] &gt;= #2025-07-01# AND [CAL_DT] &lt;= #2025-09-30# AND [VERT_CD] = 1 THEN [PLATFORM_NET_REVENUE_USD] ELSE 0 END)' />
            </column>
            <column caption='Effective Take-Rate %' datatype='real' default-format='p0.00%' name='[Calculation_take_rate]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([PLATFORM_NET_REVENUE_USD]) / SUM([GROSS_MERCHANDISE_VALUE_USD])' />
            </column>
            <column datatype='integer' name='[FISC_YR_N]' role='dimension' type='quantitative' />
            <column caption='GMV ($)' datatype='real' default-format='c&quot;$&quot;#,##0.00;(&quot;$&quot;#,##0.00)' name='[GROSS_MERCHANDISE_VALUE_USD]' role='measure' type='quantitative' />
            <column caption='Platform Net Revenue ($)' datatype='real' default-format='c&quot;$&quot;#,##0.00;(&quot;$&quot;#,##0.00)' name='[PLATFORM_NET_REVENUE_USD]' role='measure' type='quantitative' />
            <column datatype='integer' name='[VERT_CD]' role='dimension' type='quantitative' />
            <column-instance column='[APPROVED_REFUNDS_USD]' derivation='Sum' name='[sum:APPROVED_REFUNDS_USD:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_fy25_rev]' derivation='User' name='[usr:Calculation_fy25_rev:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_q3_rev]' derivation='User' name='[usr:Calculation_q3_rev:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_take_rate]' derivation='User' name='[usr:Calculation_take_rate:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.urbanfork01].[:Measure Names]'>
            <groupfilter function='union' user:op='manual'>
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.urbanfork01].[usr:Calculation_q3_rev:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.urbanfork01].[usr:Calculation_fy25_rev:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.urbanfork01].[sum:APPROVED_REFUNDS_USD:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.urbanfork01].[usr:Calculation_take_rate:qk]&quot;' />
            </groupfilter>
          </filter>
          <slices>
            <column>[federated.urbanfork01].[:Measure Names]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='cell'>
            <format attr='font-size' value='18' />
            <format attr='font-weight' value='bold' />
            <format attr='color' value='#1a73e8' />
            <format attr='text-align' value='center' />
          </style-rule>
          <style-rule element='header'>
            <format attr='font-size' value='10' />
            <format attr='font-weight' value='bold' />
            <format attr='color' value='#5f6368' />
            <format attr='text-align' value='center' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
            <encodings>
              <text column='[federated.urbanfork01].[Multiple Values]' />
            </encodings>
          </pane>
        </panes>
        <rows />
        <cols>[federated.urbanfork01].[:Measure Names]</cols>
      </table>
    </worksheet>
    <worksheet name='Monthly Net Revenue'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#202124' fontname='Tableau Bold' fontsize='12'>Monthly Platform Net Revenue by Vertical</run>
          </formatted-text>
        </title>
      </layout-options>
      <table name='Monthly Net Revenue'>
        <view>
          <datasources>
            <datasource caption='UrbanFork_Net_Revenue_Snowflake' name='federated.urbanfork01' />
          </datasources>
          <datasource-dependencies datasource='federated.urbanfork01'>
            <column caption='Order Date' datatype='date' name='[CAL_DT]' role='dimension' type='ordinal' />
            <column caption='Platform Net Revenue ($)' datatype='real' default-format='c&quot;$&quot;#,##0.00;(&quot;$&quot;#,##0.00)' name='[PLATFORM_NET_REVENUE_USD]' role='measure' type='quantitative' />
            <column caption='Vertical' datatype='string' name='[VERTICAL_NM]' role='dimension' type='nominal' />
            <column-instance column='[VERTICAL_NM]' derivation='None' name='[none:VERTICAL_NM:nk]' pivot='key' type='nominal' />
            <column-instance column='[PLATFORM_NET_REVENUE_USD]' derivation='Sum' name='[sum:PLATFORM_NET_REVENUE_USD:qk]' pivot='key' type='quantitative' />
            <column-instance column='[CAL_DT]' derivation='Month-Trunc' name='[tmn:CAL_DT:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <encodings>
              <color column='[federated.urbanfork01].[none:VERTICAL_NM:nk]' />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.urbanfork01].[sum:PLATFORM_NET_REVENUE_USD:qk]</rows>
        <cols>[federated.urbanfork01].[tmn:CAL_DT:qk]</cols>
      </table>
    </worksheet>
    <worksheet name='Regional Performance'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#202124' fontname='Tableau Bold' fontsize='12'>Net Revenue &amp; Effective Take-Rate by Region / City</run>
          </formatted-text>
        </title>
      </layout-options>
      <table name='Regional Performance'>
        <view>
          <datasources>
            <datasource caption='UrbanFork_Net_Revenue_Snowflake' name='federated.urbanfork01' />
          </datasources>
          <datasource-dependencies datasource='federated.urbanfork01'>
            <column caption='City' datatype='string' name='[CITY_NM]' role='dimension' type='nominal' />
            <column caption='Effective Take-Rate %' datatype='real' default-format='p0.00%' name='[Calculation_take_rate]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([PLATFORM_NET_REVENUE_USD]) / SUM([GROSS_MERCHANDISE_VALUE_USD])' />
            </column>
            <column caption='GMV ($)' datatype='real' default-format='c&quot;$&quot;#,##0.00;(&quot;$&quot;#,##0.00)' name='[GROSS_MERCHANDISE_VALUE_USD]' role='measure' type='quantitative' />
            <column caption='Platform Net Revenue ($)' datatype='real' default-format='c&quot;$&quot;#,##0.00;(&quot;$&quot;#,##0.00)' name='[PLATFORM_NET_REVENUE_USD]' role='measure' type='quantitative' />
            <column caption='Region' datatype='string' name='[REG_CD]' role='dimension' type='nominal' />
            <column-instance column='[CITY_NM]' derivation='None' name='[none:CITY_NM:nk]' pivot='key' type='nominal' />
            <column-instance column='[REG_CD]' derivation='None' name='[none:REG_CD:nk]' pivot='key' type='nominal' />
            <column-instance column='[PLATFORM_NET_REVENUE_USD]' derivation='Sum' name='[sum:PLATFORM_NET_REVENUE_USD:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_take_rate]' derivation='User' name='[usr:Calculation_take_rate:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <encodings>
              <color column='[federated.urbanfork01].[usr:Calculation_take_rate:qk]' />
            </encodings>
          </pane>
        </panes>
        <rows>([federated.urbanfork01].[none:REG_CD:nk] / [federated.urbanfork01].[none:CITY_NM:nk])</rows>
        <cols>[federated.urbanfork01].[sum:PLATFORM_NET_REVENUE_USD:qk]</cols>
      </table>
    </worksheet>
  </worksheets>
  <dashboards>
    <dashboard name='UrbanFork Executive Cockpit'>
      <style />
      <size maxheight='720' maxwidth='1280' minheight='720' minwidth='1280' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='1' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='96000' id='2' param='vert' type-v2='layout-flow' w='98000' x='1000' y='2000'>
            <zone h='8000' id='3' type-v2='text' w='98000' x='1000' y='2000'>
              <formatted-text>
                <run bold='true' fontcolor='#202124' fontname='Tableau Bold' fontsize='20'>UrbanFork Executive Cockpit</run>
